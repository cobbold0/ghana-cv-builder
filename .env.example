# Copy to .env.local for local development. Set the same variables in your hosting
# provider for production. All are optional locally; none are secrets.
# NEXT_PUBLIC_* values are embedded at build time, so redeploy after changing them.

# Public URL of the site, without a trailing slash. Used for canonical URLs,
# the sitemap, robots.txt and Open Graph tags. Production builds default to
# https://ghanacv.cobbold.dev; set this only to override it.
NEXT_PUBLIC_SITE_URL=

# Google Search Console verification code (the content="…" value of the HTML tag method).
# Not needed if you verify the domain with a DNS TXT record instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID. Production builds default to G-PP7163Z5PK;
# set a different ID to override, or "off" to disable. Not loaded in development.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense publisher ID. Production builds default to ca-pub-5952797612434262;
# set another ID to override, or "off" to disable. Enables the AdSense script on
# content pages (never the builder), the verification meta tag and /ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=

# AdSense display ad unit ID used for in-content ad slots on guide/example pages.
NEXT_PUBLIC_ADSENSE_SLOT=

# Development only: set to "true" to show labelled placeholder boxes where ads would appear.
NEXT_PUBLIC_AD_PLACEHOLDERS=
