# Copy to .env.local for local development. Set the same variables in your hosting
# provider for production. All are optional locally; none are secrets.
# NEXT_PUBLIC_* values are embedded at build time, so redeploy after changing them.

# Public URL of the site, without a trailing slash. Used for canonical URLs,
# the sitemap, robots.txt and Open Graph tags. REQUIRED in production.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense publisher client ID (looks like ca-pub-XXXXXXXXXXXXXXXX), after approval.
# Enables the AdSense script on content pages and /ads.txt. Leave empty to disable ads.
NEXT_PUBLIC_ADSENSE_CLIENT=

# AdSense display ad unit ID used for in-content ad slots on guide/example pages.
NEXT_PUBLIC_ADSENSE_SLOT=

# Development only: set to "true" to show labelled placeholder boxes where ads would appear.
NEXT_PUBLIC_AD_PLACEHOLDERS=
